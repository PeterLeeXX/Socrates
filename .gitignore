# Ignore everything by default.
/*

# Keep only the project source, tests, and essential root files.
!/.gitignore
!/LICENSE
!/pyproject.toml
!/README.md
!/socrates/
!/socrates/**
!/tests/
!/tests/**

# Still ignore generated Python/cache files inside allowed directories.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
